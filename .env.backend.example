# PostgreSQL Configuration (connects to existing PostgreSQL in postgres-network)
DB_HOST=PostgreSQL
DB_PORT=5432
DB_USER=ubuntu
DB_PASSWORD=your_postgres_password
DB_NAME=salesanalizer
DB_SSLMODE=disable

# API Configuration
PORT=8080
GIN_MODE=release
AUTO_MIGRATE=true

# Auth & Security Configuration
ADMIN_PASSWORD_HASH=$2a$10$abcdef...
JWT_SECRET=your_32_character_jwt_secret_key_here

# LLM Configuration
GROQ_API_KEY=your_groq_api_key
DAILY_SIGNAL_LIMIT=50

# SearXNG Internal Search Engine (0€ operating cost)
SEARXNG_URL=http://searxng:8080
